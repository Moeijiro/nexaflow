# ---------------------------------------------------------------------------
# NexaFlow — example environment. Copy to backend/.env and adjust.
# The web app reads frontend/.env.local (see frontend/.env.example).
# ---------------------------------------------------------------------------

# --- Runtime -----------------------------------------------------------------
ENVIRONMENT=development          # development | production
APP_URL=http://localhost:3000    # the web app, used for CORS and redirects
PUBLIC_API_URL=http://localhost:8000

# --- Database ----------------------------------------------------------------
# SQLite by default. For PostgreSQL:
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/nexaflow
DATABASE_URL=sqlite:///./nexaflow.db

# --- Security ----------------------------------------------------------------
# Signs sessions and derives the key that encrypts integration credentials.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_TTL_MINUTES=720
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
ALLOW_REGISTRATION=true

# --- Execution limits ---------------------------------------------------------
MAX_PAYLOAD_BYTES=65536          # largest accepted webhook body (64 KiB)
ACTION_TIMEOUT_SECONDS=10
MAX_ATTEMPTS=3                   # attempts per execution, including the first
MAX_WORKFLOWS_PER_USER=25
MAX_KEYS_PER_USER=10
# Outbound actions may not target private addresses unless this is true.
# It is the SSRF guard: keep it false outside local development.
ALLOW_PRIVATE_NETWORK_TARGETS=false
